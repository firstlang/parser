{
	"folders": [
		{
			"path": "."
		}
	],
	"extensions": {
		"recommendations": [
			"connor4312.nodejs-testing"
		],
	},
	"settings": {
		"js/ts.tsdk.path": "node_modules/typescript/lib",
		"js/ts.tsdk.promptToUseWorkspaceVersion": true,
		"nodejs-testing.extensions": [{
			"extensions": ["ts"],
			"parameters": []
		}],
		"search.exclude": {
			"**/node_modules": true,
			"context": true
		},
		"files.exclude": {
			"context": true
		},
		"nodejs-testing.include": [
			"./src-tests/"
		],
	},
	"launch": {
		"version": "0.2.0",
		"configurations": [
			{
				"type": "node",
				"request": "launch",
				"name": "Debug Parser Tests",
				"program": "src-tests/Parse.test.ts",
				"skipFiles": [
					"<node_internals>/**"
				],
				"console": "integratedTerminal"
			},
			{
				"type": "node",
				"request": "launch",
				"name": "Debug Prebuild",
				"program": "tasks.ts",
				"skipFiles": [
					"<node_internals>/**"
				],
				"console": "integratedTerminal"
			},
		]
	},
	"tasks": {
		"version": "2.0.0",
		"tasks": [
			{
				"label": "prebuild",
				"type": "npm",
				"script": "prebuild",
				"group": "build",
				"problemMatcher": []
			}
		]
	}
}
